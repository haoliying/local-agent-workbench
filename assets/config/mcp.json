{
  "$comment": "SimpleWork 预置 MCP 服务器清单（全部是网上公开、可直接安装的 MCP）。enabled:true 的会在启动时自动连接；需要密钥的先去 ~/.simplework/.env 填对应的环境变量再 sw mcp enable <id>。占位符：{{WORKSPACE}} 当前工作目录。命令：sw mcp list / sw mcp enable|disable <id> / sw mcp test <id>",
  "version": 1,
  "servers": [
    {
      "id": "filesystem",
      "name": "文件系统 Filesystem",
      "category": "文件",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{WORKSPACE}}"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "note": "官方实现：限定目录内的读写/列目录/搜索"
    },
    {
      "id": "memory",
      "name": "记忆 Memory（知识图谱）",
      "category": "记忆",
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/memory",
      "note": "官方实现：跨会话的实体/关系记忆，数据落在本地 JSON"
    },
    {
      "id": "everything",
      "name": "Everything（MCP 自检）",
      "category": "调试",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/everything",
      "note": "官方实现：用来验证 MCP 链路是否通（sw mcp test everything）"
    },
    {
      "id": "context7",
      "name": "Context7 开发文档检索",
      "category": "文档",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/upstash/context7",
      "note": "写代码时拉取最新库文档，免密钥即可用"
    },
    {
      "id": "brave-search",
      "name": "Brave 搜索",
      "category": "搜索",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "needsKey": true,
      "keyEnv": "BRAVE_API_KEY",
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/brave-search",
      "note": "官方实现：联网搜索（免费额度 https://brave.com/search/api/）"
    },
    {
      "id": "github",
      "name": "GitHub",
      "category": "代码托管",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "needsKey": true,
      "keyEnv": "GITHUB_TOKEN",
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/github",
      "note": "官方实现：仓库/Issue/PR/文件操作"
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "category": "数据库",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"],
      "env": {},
      "needsKey": true,
      "keyEnv": "DATABASE_URL",
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/postgres",
      "note": "官方实现：只读查询（postgresql://user:pass@host:5432/db）"
    },
    {
      "id": "puppeteer",
      "name": "Puppeteer 浏览器",
      "category": "浏览器",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/puppeteer",
      "note": "官方实现：网页截图 / 表单填写 / 点击导航"
    },
    {
      "id": "playwright",
      "name": "Playwright 浏览器",
      "category": "浏览器",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"],
      "env": {},
      "needsKey": false,
      "requires": "node",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "note": "微软官方：结构化快照驱动，比截图模式省 token"
    },
    {
      "id": "amap",
      "name": "高德地图 AMAP",
      "category": "地图",
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@amap/amap-maps-mcp-server"],
      "env": {
        "AMAP_MAPS_API_KEY": "${AMAP_MAPS_API_KEY}"
      },
      "needsKey": true,
      "keyEnv": "AMAP_MAPS_API_KEY",
      "requires": "node",
      "homepage": "https://github.com/amap-open/amap-maps-mcp-server",
      "note": "地理编码/路径规划/POI 搜索（高德控制台申请 Key）"
    },
    {
      "id": "git",
      "name": "Git 仓库",
      "category": "代码托管",
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "{{WORKSPACE}}"],
      "env": {},
      "needsKey": false,
      "requires": "uv",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "note": "官方实现：git log/diff/branch 等，需安装 uv（pip install uv）"
    },
    {
      "id": "fetch",
      "name": "网页抓取 Fetch",
      "category": "网络",
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {},
      "needsKey": false,
      "requires": "uv",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
      "note": "官方实现：把网页转成 markdown，需 uv"
    },
    {
      "id": "time",
      "name": "时间时区 Time",
      "category": "工具",
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone", "Asia/Shanghai"],
      "env": {},
      "needsKey": false,
      "requires": "uv",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/time",
      "note": "官方实现：当前时间与时区换算，需 uv"
    },
    {
      "id": "sqlite",
      "name": "SQLite 数据库",
      "category": "数据库",
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "{{WORKSPACE}}/simplework.db"],
      "env": {},
      "needsKey": false,
      "requires": "uv",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/sqlite",
      "note": "官方实现：本地 SQLite 读写与查询，需 uv"
    },
    {
      "id": "my-http-server",
      "name": "（模板）HTTP 类型 MCP",
      "category": "模板",
      "enabled": false,
      "transport": "http",
      "url": "http://127.0.0.1:3000/mcp",
      "headers": {
        "Authorization": "Bearer ${MY_MCP_TOKEN}"
      },
      "needsKey": false,
      "requires": "",
      "homepage": "",
      "note": "示例：远程 HTTP/SSE MCP 服务器这样配（改 url 和 headers 即可）"
    }
  ]
}
